# FastAPI JWT
SECRET_KEY=change-me-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=50
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (SQLite default or AWS RDS / PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./smart_college.db
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/studentmanagement_system

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
S3_BUCKET_NAME=

# AWS SQS
SQS_QUEUE_URL=

# Email Configuration
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# AI Services (Groq = Blazing Fast <0.4s response, Gemini = Fast <1s, OpenRouter, HuggingFace)
# Get a free Groq key in 30s at https://console.groq.com/keys (No credit card needed)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
