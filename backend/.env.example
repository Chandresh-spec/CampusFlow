# FastAPI JWT
SECRET_KEY=change-me-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=50
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (SQLite default or AWS RDS / PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./smart_college.db
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/studentmanagement_system

# Redis (OTP & Cache)
REDIS_URL=redis://localhost:6379/0

# OTP & Registration Abuse Protection
OTP_SECRET_KEY=
OTP_EXPIRE_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_WINDOW=5
OTP_RATE_LIMIT_WINDOW_SECONDS=3600
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_ATTEMPT_LOCKOUT_SECONDS=900

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
S3_BUCKET_NAME=

# AWS SQS
SQS_QUEUE_URL=

# Email Configuration
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# AI Services (Groq = Blazing Fast <0.4s response, Gemini = Fast <1s, OpenRouter, HuggingFace)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
