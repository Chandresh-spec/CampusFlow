# FastAPI JWT
SECRET_KEY=change-me-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=50
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (SQLite default or AWS RDS / PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./smart_college.db
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/studentmanagement_system

# AWS S3 Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
S3_BUCKET_NAME=

# AWS SQS Queue
SQS_QUEUE_URL=

# Gmail SMTP (For OTP Verification & Alerts)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# AI Services (Groq for ultra-fast LPU responses, HuggingFace for RAG embeddings)
GROQ_API_KEY=
HUGGINGFACE_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Google OAuth (Identity Services GIS)
GOOGLE_CLIENT_ID=571536711772-lvumlfrpk4ql0v9l7e1hnja1lm0hgmpo.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=571536711772-lvumlfrpk4ql0v9l7e1hnja1lm0hgmpo.apps.googleusercontent.com

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
