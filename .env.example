# ========================================================
# FastAPI & JWT Authentication
# ========================================================
SECRET_KEY=change-me-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=50
REFRESH_TOKEN_EXPIRE_DAYS=7

# ========================================================
# Database Configuration (AWS RDS PostgreSQL / SQLite for Local)
# For local testing: sqlite+aiosqlite:///./smart_college.db
# For AWS RDS: postgresql+asyncpg://USER:PASSWORD@RDS-ENDPOINT:5432/DBNAME
# ========================================================
DATABASE_URL=sqlite+aiosqlite:///./smart_college.db

# ========================================================
# AWS S3 Storage
# ========================================================
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-southeast-2
S3_BUCKET_NAME=your-s3-bucket-name

# ========================================================
# AWS SQS Queue
# ========================================================
SQS_QUEUE_URL=https://sqs.ap-southeast-2.amazonaws.com/your-account-id/your-queue-name

# ========================================================
# Email Configuration (SMTP for OTPs)
# ========================================================
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# ========================================================
# AI Services (Hugging Face Inference API)
# ========================================================
HUGGINGFACE_API_KEY=your-huggingface-api-key

# ========================================================
# Frontend URL (CORS)
# ========================================================
FRONTEND_URL=http://localhost:3000
